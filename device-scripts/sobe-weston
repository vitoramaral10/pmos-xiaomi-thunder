#!/bin/sh
pkill phoc 2>/dev/null; pkill weston 2>/dev/null; sleep 1
pgrep seatd >/dev/null || ( seatd -g video >/var/log/seatd.log 2>&1 & )
sleep 2
mkdir -p /tmp/xdgrt; chmod 700 /tmp/xdgrt
cat > /tmp/weston.ini <<"WEOF"
[core]
idle-time=0
require-input=false
[shell]
locking=false
panel-position=top
[output]
name=DSI-1
mode=1080x2408
WEOF
export XDG_RUNTIME_DIR=/tmp/xdgrt
export LIBSEAT_BACKEND=seatd
( setsid sleep 3600 | timeout 3500 weston --backend=drm --renderer=pixman -c /tmp/weston.ini --log=/var/log/weston.log ) >/dev/null 2>&1 &
echo "weston lancado, log em /var/log/weston.log"
