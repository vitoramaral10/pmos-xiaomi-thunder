#!/bin/sh
# Sobe o Weston no painel DSI com renderizacao por software.
# O sleep na entrada mantem o stdin aberto: o compositor sai por EOF sem isso.
export XDG_RUNTIME_DIR=/run/xdg-weston
export LIBSEAT_BACKEND=seatd
export WLR_RENDERER=pixman
export WLR_NO_HARDWARE_CURSORS=1
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
exec sh -c "sleep 2147483647 | exec weston \
  --backend=drm \
  --renderer=pixman \
  -c /etc/weston-thunder.ini \
  --log=/var/log/weston.log"
