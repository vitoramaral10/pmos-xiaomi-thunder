#!/sbin/openrc-run

name="weston-thunder"
description="Compositor Weston no painel DSI (renderizacao por software)"

command="/usr/local/bin/weston-thunder-launch"
command_background="yes"
pidfile="/run/weston-thunder.pid"
output_log="/var/log/weston-thunder.log"
error_log="/var/log/weston-thunder.log"

# O despertar do touchscreen NAO fica aqui: e do servico
# touchscreen-thunder-wake, entregue pelo device-xiaomi-thunder, para nao
# amarrar o toque a escolha de compositor.
depend() {
    need seatd
    after dbus udev elogind localmount touchscreen-thunder-wake
}

start_pre() {
    checkpath -d -m 0700 /run/xdg-weston
    return 0
}
