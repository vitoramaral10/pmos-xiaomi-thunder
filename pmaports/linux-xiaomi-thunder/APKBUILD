# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/light_defconfig
#
# ATENCAO -- NAO PUBLICAR ESTE APORT EM REPOSITORIO PUBLICO.
# A entrada de source "mtk-connectivity-gen4m-mt6833-1.tar.gz" contem codigo
# de conectividade da MediaTek (wmt_drv / wmt_chrdev_wifi / wlan_drv_gen4m /
# connfem) redistribuido de um drop de kernel de terceiro. Nao ha licenca que
# autorize redistribuicao publica. Mesma restricao ja aplicada ao firmware do
# touchscreen: uso local apenas.
maintainer=""
pkgname=linux-xiaomi-thunder
pkgver=4.19.191
pkgrel=21
_commit=a40ceab8943703f33e935cb0b86d0f69aa2044dd
# Drop do driver de conectividade MediaTek enxertado em prepare().
_conndrop=mtk-connectivity-gen4m-mt6833-1
pkgdesc="Xiaomi POCO M4 5G kernel fork"
arch="aarch64"
url="https://github.com/MiCode/Xiaomi_Kernel_OpenSource/tree/light-u-oss"
license="GPL-2.0-only"
makedepends="
	bash
	bc
	bison
	cpio
	devicepkg-dev
	findutils
	flex
	kmod
	openssl-dev
	perl
	xz
	"
source="
	$pkgname-$_commit.tar.gz::https://github.com/MiCode/Xiaomi_Kernel_OpenSource/archive/$_commit.tar.gz
	$_conndrop.tar.gz
	connectivity-Makefile-mt6833
	gen4m-mt6833-kernel419.diff
	config-${pkgname#linux-}.$arch
	fix-selinux-host-includes.patch
	fix-external-inline-declarations.patch
	use-system-cpio.patch
	fix-gcc-modern-compat.patch
	fix-sia81xx-vla.patch
	build-mt6833-dtb.patch
	fix-u-serial-null-close.patch
	fix-mtk-gem-ion-null.patch
	"
builddir="$srcdir/Xiaomi_Kernel_OpenSource-$_commit"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
	"
_outdir="out"

_carch="arm64"

# Used internally by pmbootstrap. Don't touch.
# TODO: Remove once minimum default pmbootstrap version supports
# kernel packages without '_flavor' and '_config'.
_config="config-${pkgname#linux-}.$arch"
_flavor="${pkgname#linux-}"

prepare() {
	default_prepare

	# ---------------------------------------------------------------
	# Enxerto do driver de conectividade MediaTek (gen4m, drop MT6833)
	#
	# Por que tarball e nao patch: sao ~23 MB / 763 arquivos de codigo
	# de terceiro, sem historico comum com o tarball do kernel. Um
	# patch desse tamanho e ilegivel, quebra em qualquer refresh e
	# multiplica o tempo de "abuild unpack". Como tarball proprio o
	# conteudo fica intacto, verificavel por sha512 e trivial de
	# substituir por outro drop.
	#
	# Roda ANTES de downstreamkernel_prepare de proposito: aquele
	# script varre o builddir inteiro removendo -Werror de todo
	# Makefile / Makefile.common / Kbuild, e a arvore enxertada precisa
	# passar por essa varredura (e drop de kernel 4.14 compilando em
	# 4.19; vai gerar warning).
	# ---------------------------------------------------------------
	local _conn="$builddir/drivers/misc/mediatek/connectivity"
	local _drop="$srcdir/$_conndrop"
	local _d

	for _d in wmt_drv wmt_chrdev_wifi wlan_drv_gen4m connfem; do
		msg "connectivity: instalando $_d"
		rm -rf "$_conn/$_d"
		cp -a "$_drop/$_d" "$_conn/$_d"
	done

	# connectivity/common/ -- OBRIGATORIO.
	# O struct wmt_platform_bridge tem layout diferente entre geracoes:
	# o do tarball light-u-oss tem "debug_write_cb; debug_read_cb;" e o
	# do drop tem "debug_cb;" mais conninfra_reg_is_bus_hang_no_lock_cb.
	# Sem esta troca a bridge le e escreve campos trocados, sem erro de
	# compilacao nem de link -- falha silenciosa em runtime.
	# Os arquivos vem do proprio wmt_drv/ do drop: sao, por construcao,
	# a mesma versao que wmt_drv.ko espera.
	# Conferido: nenhum outro arquivo do kernel alvo inclui
	# wmt_build_in_adapter.h ou connectivity_build_in_adapter.h, entao a
	# troca nao respinga fora de connectivity/.
	msg "connectivity: substituindo common/ (wmt_platform_bridge)"
	cp -f "$_drop/wmt_drv/connectivity_build_in_adapter.c" \
		"$_drop/wmt_drv/connectivity_build_in_adapter.h" \
		"$_drop/wmt_drv/wmt_build_in_adapter.c" \
		"$_drop/wmt_drv/wmt_build_in_adapter.h" \
		"$_conn/common/"

	# Makefile do connectivity: o do tarball hardcoda
	# MTK_COMBO_CHIP=CONNAC e WLAN_CHIP_ID=6765 (errado para MT6833).
	msg "connectivity: instalando Makefile MT6833"
	cp -f "$srcdir/connectivity-Makefile-mt6833" "$_conn/Makefile"

	# Correcoes de compilacao do drop em kernel 4.19. Aplicado AQUI, e nao
	# via default_prepare, porque aquele roda antes da copia acima e seria
	# sobrescrito. Conteudo: (a) plat_priv.c do mt6833 nao pode incluir
	# <linux/pm_qos.h> no ramo 4.19, senao os #define pm_qos_*->mtk_pm_qos_*
	# colidem com mtk-pm-qos.h; e precisa de cpu_ctrl.h e topo_ctrl.h, que o
	# drop so incluia no ramo antigo. (b) LIST_SEG_MAX definido localmente em
	# gl_qa_agent.h e (c) stub de wlanoidListMode em wlan_oid.c.
	#
	# (b) e (c) ficaram INERTES a partir de r17, quando o wlan_service passou
	# a ser compilado (MTK_WLAN_SERVICE_PATH no connectivity-Makefile-mt6833,
	# com a evidencia toda documentada la). Nao foram removidos de proposito:
	# (b) e "#ifndef LIST_SEG_MAX" com o mesmo valor 100 de
	# net_adaption.h:1215 -- redefinicao identica, que o C aceita sem
	# diagnostico -- e (c) e "#if (CONFIG_WLAN_SERVICE != 1)", cujo ramo #else
	# e o codigo original. Os dois voltam a valer sozinhos se algum dia o
	# servico for desligado de novo.
	msg "connectivity: aplicando correcoes de kernel 4.19"
	patch -p1 -d "$_conn" < "$srcdir/gen4m-mt6833-kernel419.diff"

	REPLACE_GCCH=0
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" HOSTCC=gcc HOSTCXX=g++ \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))"-postmarketOS
}

package() {
	# O bootloader MTK deste aparelho so aceita kernel comprimido: o boot.img
	# de fabrica carrega Image.gz (magic 1f8b), nao Image cru. Sem isto o
	# downstreamkernel_package escolhe "Image" e o aparelho entra em bootloop
	# sem nunca executar o kernel.
	export KERNEL_IMAGE_NAME="Image.gz"
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"${pkgname#linux-}" "$_outdir"
	make dtbs_install O="$_outdir" ARCH="$_carch" \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	# downstreamkernel_package so instala kernel.release e boot/vmlinuz --
	# nenhum modulo. Como o Wi-Fi sai como .ko, precisamos disto.
	# INSTALL_MOD_STRIP=1 porque o config tem CONFIG_DEBUG_INFO=y e
	# wlan_drv_gen4m.ko sem strip carrega dezenas de MB de DWARF; o
	# options="!strip" acima so desliga o strip do proprio abuild, nao
	# interfere aqui. modules_install ja roda depmod sozinho (dai o kmod
	# em makedepends).
	make modules_install O="$_outdir" ARCH="$_carch" \
		INSTALL_MOD_PATH="$pkgdir" INSTALL_MOD_STRIP=1

	# symlinks build/ e source/ apontam para o diretorio de build e ficam
	# pendurados dentro do apk.
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source
}

