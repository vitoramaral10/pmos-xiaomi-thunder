# Reference: <https://postmarketos.org/devicepkg>
#
# NAO ENVIAR PARA O UPSTREAM DO PMAPORTS COMO ESTA.
# O subpacote $pkgname-nonfree-firmware carrega dois blobs proprietarios
# Novatek/Xiaomi (nt36672c_tm_01_ts_{fw,mp}.bin) extraidos da particao vendor
# da ROM de fabrica. A redistribuicao nao e autorizada, entao estes .bin nao
# podem ser versionados em repo publico nem enviados ao pmaports. Para
# upstream, o caminho seria um pacote firmware-* que baixe/extraia o blob da
# ROM na maquina do usuario, como o pmaports faz em device/*/firmware-*.
maintainer=""
pkgname=device-xiaomi-thunder
pkgver=1
pkgrel=11
pkgdesc="Xiaomi POCO M4 5G"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
# stevia-schemas: o pacote do teclado de tela (stevia) entrega o binario, mas
# poe o schema GSettings num subpacote a parte que nada puxa. Sem ele o teclado
# morre com GLib-GIO-ERROR "Settings schema 'mobi.phosh.osk' is not installed",
# e como e componente OBRIGATORIO da sessao, o Phosh inteiro nao sobe.
depends="
	android-tools-mkbootimg
	linux-xiaomi-thunder
	postmarketos-base
	postmarketos-base-downstream
	busybox-extras
	seatd
	stevia-schemas
	"
makedepends="devicepkg-dev"
install="$pkgname.post-install $pkgname.post-upgrade"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="
	deviceinfo
	modules-initfs
	$pkgname.post-install
	$pkgname.post-upgrade
	touchscreen-thunder-wake.initd
	phrog-session-pixman
	phosh-session-thunder
	nt36672c_tm_01_ts_fw.bin
	nt36672c_tm_01_ts_mp.bin
	"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Acorda o controlador de toque a cada boot. Fica no pacote principal, e
	# nao no subpacote de firmware, porque e script livre e nao depende do
	# blob: sem firmware ele so avisa e sai com 0.
	# O runlevel e adicionado no .post-install / .post-upgrade.
	install -D -m755 "$srcdir"/touchscreen-thunder-wake.initd \
		"$pkgdir"/etc/init.d/touchscreen-thunder-wake

	# Ambiente das sessoes graficas. O greeter e a sessao do usuario sobem por
	# caminhos totalmente separados e NENHUM dos dois recebe por padrao o que
	# este aparelho precisa, entao cada um tem seu proprio script.
	# O .post-install aponta o greetd e o phosh.desktop para ca.
	install -D -m755 "$srcdir"/phrog-session-pixman \
		"$pkgdir"/usr/bin/phrog-session-pixman
	install -D -m755 "$srcdir"/phosh-session-thunder \
		"$pkgdir"/usr/bin/phosh-session-thunder
}

nonfree_firmware() {
	pkgdesc="Firmware proprietario do touchscreen Novatek NT36672C"
	license="proprietary"
	depends=""
	# So arquivos de dados: nada de script do apk nem de rastreio de ELF.
	install=""
	options="!archcheck !check !tracedeps"

	# O NT36672C e host-download: o IC nao guarda firmware proprio e o host
	# envia a cada boot. Sem o .bin o driver loga
	# "update_firmware_request: firmware load failed, ret=-2" (-ENOENT), fica
	# no bootloader e nunca levanta a linha de interrupcao.
	#
	# Destino /lib/firmware/ (o caminho que o request_firmware procura), que
	# neste rootfs e symlink para /usr/lib — por isso o pacote instala em
	# usr/lib/firmware, e nao em lib/firmware, que colidiria com o symlink.
	# Sem subpasta: o driver pede o nome cru, via
	# request_firmware("nt36672c_tm_01_ts_fw.bin").
	install -D -m644 "$srcdir"/nt36672c_tm_01_ts_fw.bin \
		"$subpkgdir"/usr/lib/firmware/nt36672c_tm_01_ts_fw.bin
	install -D -m644 "$srcdir"/nt36672c_tm_01_ts_mp.bin \
		"$subpkgdir"/usr/lib/firmware/nt36672c_tm_01_ts_mp.bin
}

