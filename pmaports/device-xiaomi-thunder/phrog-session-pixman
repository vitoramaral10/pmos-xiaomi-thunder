#!/bin/sh
# Sessao do greeter (phrog) com o ambiente que este aparelho exige.
#
# LIBSEAT_BACKEND=seatd e' o decisivo: com o backend do logind a sessao e'
# desativada, o phoc libera o display e desligar o CRTC trava este painel ate'
# o watchdog de hardware resetar o aparelho. O Weston sempre usou seatd e nao
# cai. Com esta linha, todo "Failed to disable CRTC" sumiu dos logs.
export LIBSEAT_BACKEND=seatd

# Com o panfrost carregado (kernel r32+) a Mali-G57 tem render node: wlroots
# compoe em GLES e o GTK desenha em GL. Sem ele, o caminho antigo: pixman,
# cairo e Mesa por software.
if [ -e /dev/dri/renderD128 ]; then
	export WLR_RENDERER=gles2
	export GSK_RENDERER=ngl
else
	export WLR_RENDERER=pixman
	export GSK_RENDERER=cairo
	export LIBGL_ALWAYS_SOFTWARE=1
fi
export WLR_NO_HARDWARE_CURSORS=1
export WLR_BACKENDS=drm,libinput
export GDK_BACKEND=wayland

exec /usr/libexec/phrog-greetd-session "$@"
