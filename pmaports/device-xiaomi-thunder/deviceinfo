deviceinfo_format_version="0"
deviceinfo_name="Xiaomi POCO M4 5G"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="xiaomi-thunder"
deviceinfo_year="2022"
deviceinfo_dtb="mediatek/mt6833"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_initfs_compression="gzip"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_kernel_cmdline="bootopt=64S3,32N2,64N2 buildvariant=user"
deviceinfo_generate_bootimg="true"
deviceinfo_flash_fastboot_partition_kernel="boot"
deviceinfo_flash_fastboot_partition_rootfs="userdata"
deviceinfo_flash_pagesize="2048"
deviceinfo_header_version="2"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x40080000"
deviceinfo_flash_offset_ramdisk="0x51100000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x47c80000"
deviceinfo_flash_offset_dtb="0x47c80000"
deviceinfo_bootimg_qcdt="false"
deviceinfo_dtb_second="false"

# O armazenamento UFS deste aparelho usa setor logico de 4096 bytes. Sem isto a
# imagem e criada com setores de 512, o fdisk do initramfs le a GPT aninhada
# errado, conta 1 particao em vez de 2, e mount_subpartitions desiste com
# "failed to mount subpartitions". O initramfs usa este valor no
# 'losetup --sector-size'.
deviceinfo_rootfs_image_sector_size="4096"

# NCM no f_ncm do MUSB MediaTek degrada e trava o enlace, ver CLAUDE_HANDOFF r15
deviceinfo_usb_network_function="rndis.usb0"
